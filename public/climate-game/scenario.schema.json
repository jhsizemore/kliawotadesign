{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kliawota.design/climate-game/scenario.schema.json",
  "title": "Island Together scenario pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "strap",
    "topology",
    "summary",
    "landforms",
    "nodes",
    "links",
    "projectTargets",
    "hazardTargets",
    "goals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string"
    },
    "strap": {
      "type": "string"
    },
    "topology": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "briefing": {
      "type": "string"
    },
    "landforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "d"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "d": {
            "type": "string",
            "minLength": 1
          },
          "reef": {
            "type": "boolean"
          },
          "surf": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "d"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "reef-flat",
              "lagoon",
              "highland",
              "ridge",
              "river",
              "harbour",
              "mangrove",
              "garden",
              "settlement",
              "beach",
              "reef-pass",
              "feature",
              "water",
              "contour"
            ]
          },
          "d": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "x",
          "y",
          "stats",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "island": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "stats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "mode"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "road",
              "path",
              "boat"
            ]
          },
          "d": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "projectTargets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "logistics": {
      "type": "object",
      "properties": {
        "hub": {
          "type": "string"
        },
        "remoteZones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseTravelSeasons": {
          "type": "integer",
          "minimum": 0
        },
        "disruptionHazards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "hazardTargets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "target",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "target": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "special": {
      "type": "object"
    },
    "geographyBasis": {
      "type": "string"
    },
    "landscape": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "x",
          "y"
        ],
        "properties": {
          "kind": {
            "enum": [
              "forest",
              "palms",
              "reef",
              "canoe",
              "boat",
              "garden",
              "village"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotate": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
